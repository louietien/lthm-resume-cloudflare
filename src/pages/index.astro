---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import { SITE_DATA } from "../content";
const site = SITE_DATA;
const statement =
  "I like getting to the root of a problem. Then building something that makes the next person’s day a little easier.";
const technologies = [
  "Microsoft 365",
  "Azure",
  "PowerShell",
  "Node.js",
  "AI agents",
  "Docker",
  "Make",
  "monday.com",
];
---

<Layout title={site.page_title}>
  <main id="main-content">
    <header class="hero wrap">
      <div class="hero-topline">
        <p>Louie Hegeler-Meile</p>
        <p>
          Copenhagen, Denmark{" "}
          <span class="location-dot" aria-hidden="true"></span>
        </p>
      </div>
      <div class="hero-composition">
        <div class="hero-copy">
          <h1 class="max-w-6xl">
            Good people.
            <br />
            <span>Better systems.</span>
          </h1>
          <p class="hero-description">
            I’m Louie. I solve technical problems, build useful tools, and make
            IT work better for the people using it.
          </p>
          <div class="hero-actions">
            <button class="btn" type="button" id="contact-popup-trigger">
              Let’s connect <span aria-hidden="true">↗</span>
            </button>
            <a class="btn btn-ghost" href="#projects">
              Explore my work <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
        <figure class="profile-shell">
          <div class="portrait-frame">
            <img
              class="profile-photo"
              src="/profile.jpg"
              width="400"
              height="400"
              alt="Louie Hegeler-Meile, smiling in a sunlit courtyard"
              fetchpriority="high"
            />
          </div>
          <figcaption>
            <span>A curious mind. A practical approach.</span>
            <span aria-hidden="true">↗</span>
          </figcaption>
        </figure>
      </div>
      <a class="scroll-cue" href="#about">
        <span>Meet the person behind the work</span>
        <span aria-hidden="true">↓</span>
      </a>
    </header>

    <section class="section wrap" id="about" aria-labelledby="about-title">
      <div class="section-heading">
        <h2 id="about-title">
          People first.
          <br />
          <span>Technical by nature.</span>
        </h2>
        <p>
          Support, systems, and a habit of
          <br class="desktop-break" /> making things a little better.
        </p>
      </div>
      <div class="bento-grid">
        <article class="bento-intro">
          <img
            src="https://picsum.photos/seed/copenhagen-architecture/1000/1100"
            width="1000"
            height="1100"
            alt=""
            loading="lazy"
            class="bento-image"
          />
          <div class="bento-intro-copy">
            <h3>Hi, I’m Louie.</h3>
            <p>{site.about.paragraphs[0]}</p>
            <a href="#experience">
              Here’s where I’ve been <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
        <article class="bento-card">
          <span class="card-symbol" aria-hidden="true">
            ↗
          </span>
          <h3>In the thick of IT.</h3>
          <p>
            Technical Support Engineer at SecTeer, helping customers with
            VulnDetect and PatchPro.
          </p>
          <span class="card-note">The day job</span>
        </article>
        <article class="bento-card bento-accent">
          <span class="card-symbol" aria-hidden="true">
            ⌘
          </span>
          <h3>Built on experience.</h3>
          <p>
            6+ years across IT operations, systems administration, and
            implementation consulting.
          </p>
          <span class="card-note">A hands-on background</span>
        </article>
        <article class="bento-card">
          <span class="card-symbol" aria-hidden="true">
            {"{ }"}
          </span>
          <h3>Always building.</h3>
          <p>
            Internal tools, workflow automations, and AI agents that turn
            everyday friction into something useful.
          </p>
          <a class="card-note" href="/projects">
            Browse the projects <span aria-hidden="true">↗</span>
          </a>
        </article>
        <article class="bento-card">
          <span class="card-symbol" aria-hidden="true">
            ◎
          </span>
          <h3>Away from the desk.</h3>
          <p>
            Music, gaming, travel, and PC builds. Curious about how things work,
            on and off the clock.
          </p>
          <span class="card-note">There’s more to the person</span>
        </article>
      </div>
      <details class="story-details">
        <summary>
          A little more of my story <span aria-hidden="true">+</span>
        </summary>
        <div class="story-columns">
          {site.about.paragraphs.slice(1).map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </details>
    </section>

    <div
      class="tech-marquee"
      aria-label={`Tools I work with: ${technologies.join(", ")}`}
    >
      <div class="marquee-track" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {technologies.map((tech) => (
              <span>
                {tech}
                <i>·</i>
              </span>
            ))}
          </div>
        ))}
      </div>
      <button
        class="marquee-pause"
        type="button"
        aria-label="Pause technology marquee"
        aria-pressed="false"
      >
        Pause
      </button>
    </div>

    <section
      class="section wrap"
      id="experience"
      aria-labelledby="experience-title"
    >
      <div class="section-heading">
        <h2 id="experience-title">
          A few chapters.
          <br />
          <span>One common thread.</span>
        </h2>
        <p>
          Helping people get more
          <br class="desktop-break" /> from their technology.
        </p>
      </div>
      <div class="experience-list">
        {site.experience.items.map((item, i) => (
          <article class="experience-item">
            <div class="experience-company">
              {item.logo.type === "image" ? (
                <img
                  src={item.logo.src}
                  alt={item.logo.alt}
                  width="48"
                  height="48"
                  loading="lazy"
                />
              ) : (
                <span class="company-badge" aria-hidden="true">
                  {item.logo.text}
                </span>
              )}
              <div>
                <h3>{item.meta.company}</h3>
                <p>{item.meta.location}</p>
              </div>
            </div>
            <div class="experience-role">
              <h4>{item.title}</h4>
              <p>{item.description}</p>
            </div>
            <div class="experience-date">
              <span>{item.meta.period}</span>
              <span class={i === 0 ? "current-role" : ""}>
                {i === 0 ? "Current role" : item.meta.employment}
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="approach-section" aria-label="How I approach my work">
      <div class="wrap">
        <p class="reveal-text" aria-label={statement}>
          {statement.split(" ").map((word) => (
            <span aria-hidden="true">{word} </span>
          ))}
        </p>
        <p class="approach-signature">
          A practical approach. A human perspective.
        </p>
      </div>
    </section>

    <section
      class="section wrap"
      id="projects"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <h2 id="projects-title">
          Made to solve
          <br />
          <span>real problems.</span>
        </h2>
        <p>{site.projects_section.description}</p>
      </div>
      <div class="project-accordion">
        {site.projects_section.projects.map((item, i) => (
          <article class:list={["project-slice", { "is-expanded": i === 0 }]}>
            <button
              class="project-toggle"
              type="button"
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`project-panel-${i}`}
            >
              <span>{item.title}</span>
              <span class="slice-plus" aria-hidden="true">
                +
              </span>
            </button>
            <div
              class="project-panel"
              id={`project-panel-${i}`}
              inert={i !== 0}
            >
              <div
                class:list={["project-art", `project-art-${i}`]}
                aria-hidden="true"
              >
                <div class="mini-window">
                  <div class="mini-toolbar">
                    <i></i>
                    <i></i>
                    <i></i>
                    <span>
                      {
                        [
                          "Workspace",
                          "Knowledge",
                          "Time off",
                          "System status",
                          "Admin console",
                        ][i]
                      }
                    </span>
                  </div>
                  <div class="mini-layout">
                    <div class="mini-sidebar">
                      <b></b>
                      <b></b>
                      <b></b>
                      <b></b>
                    </div>
                    <div class="mini-content">
                      <strong>
                        {
                          [
                            "A place for everything.",
                            "Answers, a little closer.",
                            "A clearer calendar.",
                            "Everything in view.",
                            "Less busywork.",
                          ][i]
                        }
                      </strong>
                      <div class="mini-blocks">
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="mini-lines">
                        <b></b>
                        <b></b>
                        <b></b>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <p>{item.description}</p>
              <a
                class="text-link"
                href={item.href ?? "/projects"}
                target={item.href ? "_blank" : undefined}
                rel={item.href ? "noreferrer" : undefined}
              >
                {item.href ? "Explore the demo" : "See project details"}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-ghost" href="/projects">
          All projects <span aria-hidden="true">↗</span>
        </a>
        <p>Small tools. Useful outcomes.</p>
      </div>
    </section>

    <section
      class="section wrap skills-section"
      id="skills"
      aria-labelledby="skills-title"
    >
      <div>
        <h2 id="skills-title">The toolkit.</h2>
        <p class="section-intro">A mix of technical depth and people skills.</p>
        <ul class="tags">
          {site.skills.items.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </div>
      <div class="education">
        <h2>Where it started.</h2>
        {site.skills.education.map((school) => (
          <article>
            <h3>{school.school}</h3>
            <p>{school.meta}</p>
            {school.description && <p>{school.description}</p>}
          </article>
        ))}
      </div>
    </section>

    <section
      class="section wrap personal-section"
      aria-labelledby="personal-title"
    >
      <div class="personal-intro">
        <h2 id="personal-title">
          Beyond the
          <br />
          <span>job title.</span>
        </h2>
        <div class="carousel-controls">
          <button
            type="button"
            id="note-prev"
            aria-label="Previous personal note"
          >
            ←
          </button>
          <button type="button" id="note-next" aria-label="Next personal note">
            →
          </button>
        </div>
      </div>
      <div
        class="personal-carousel"
        aria-roledescription="carousel"
        aria-label="Personal notes"
      >
        <div class="note-slides">
          {site.snapshot.items.map((item, i) => (
            <article class="note-slide" hidden={i !== 0}>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
        <p id="note-status" class="note-status" aria-live="polite">
          1 / {site.snapshot.items.length}
        </p>
      </div>
    </section>
    <Contact />
  </main>

  <dialog
    id="contact-modal"
    class="contact-dialog"
    aria-labelledby="contact-modal-title"
  >
    <div class="modal-header">
      <h2 id="contact-modal-title">Let’s connect.</h2>
      <button
        class="modal-close"
        id="contact-modal-close"
        type="button"
        aria-label="Close contact details"
      >
        ×
      </button>
    </div>
    <p>Always happy to meet good people.</p>
    <div class="modal-row">
      <span>Email</span>
      <a href={`mailto:${site.hero.contact_popup.email}`}>
        {site.hero.contact_popup.email} ↗
      </a>
    </div>
    <div class="modal-row">
      <span>Phone</span>
      <a href={`tel:${site.hero.contact_popup.phone}`}>
        {site.hero.contact_popup.phone}
      </a>
    </div>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#contact-modal");
    document
      .querySelector("#contact-popup-trigger")
      ?.addEventListener("click", () => dialog?.showModal());
    document
      .querySelector("#contact-modal-close")
      ?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    const slices = [
      ...document.querySelectorAll<HTMLElement>(".project-slice"),
    ];
    function expand(slice: HTMLElement) {
      slices.forEach((item) => {
        const active = item === slice;
        item.classList.toggle("is-expanded", active);
        item
          .querySelector("button")
          ?.setAttribute("aria-expanded", String(active));
        const panel = item.querySelector<HTMLElement>(".project-panel");
        if (panel) panel.inert = !active;
      });
    }
    slices.forEach((slice) => {
      slice
        .querySelector("button")
        ?.addEventListener("click", () => expand(slice));
      slice.addEventListener("pointerenter", (event) => {
        if (
          event.pointerType === "mouse" &&
          window.matchMedia("(min-width: 960px)").matches &&
          !slices.some((item) => item.contains(document.activeElement))
        )
          expand(slice);
      });
    });
    const slides = [...document.querySelectorAll<HTMLElement>(".note-slide")];
    let current = 0;
    function showNote(direction: number) {
      current = (current + direction + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.hidden = i !== current;
      });
      const status = document.querySelector("#note-status");
      if (status)
        status.textContent = `${current + 1} / ${slides.length} — ${slides[current].querySelector("h3")?.textContent}`;
    }
    document
      .querySelector("#note-prev")
      ?.addEventListener("click", () => showNote(-1));
    document
      .querySelector("#note-next")
      ?.addEventListener("click", () => showNote(1));
    const marqueeButton =
      document.querySelector<HTMLButtonElement>(".marquee-pause");
    marqueeButton?.addEventListener("click", () => {
      const paused =
        marqueeButton.closest(".tech-marquee")?.classList.toggle("is-paused") ??
        false;
      marqueeButton.setAttribute("aria-pressed", String(paused));
      marqueeButton.setAttribute(
        "aria-label",
        `${paused ? "Resume" : "Pause"} technology marquee`,
      );
      marqueeButton.textContent = paused ? "Resume" : "Pause";
    });
  </script>
</Layout>
