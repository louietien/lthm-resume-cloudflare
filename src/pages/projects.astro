---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import { PROJECTS_DATA } from "../content";
const data = PROJECTS_DATA;
---

<Layout title={data.page_title}>
  <main id="main-content">
    <header class="projects-hero wrap">
      <a href="/" class="back-link">
        <span aria-hidden="true">←</span> Back to the portfolio
      </a>
      <h1>
        Useful by design.
        <br />
        <span>Built by curiosity.</span>
      </h1>
      <p>
        A collection of internal tools, automations, and web apps. Built to make
        everyday work a little easier.
      </p>
    </header>
    <section class="projects-catalog wrap" aria-label="Project collection">
      <div class="catalog-toolbar">
        <div
          class="filter-bar"
          id="filter-bar"
          role="group"
          aria-label="Filter projects by technology"
        >
          {data.filters.map((filter, i) => (
            <button
              type="button"
              class:list={["filter-btn", { "is-active": i === 0 }]}
              data-filter={filter}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {filter}
            </button>
          ))}
        </div>
        <p
          class="project-count"
          id="project-count"
          role="status"
          aria-live="polite"
        >
          {data.projects.length} projects
        </p>
      </div>
      <div class="project-grid">
        {data.projects.map((item) => (
          <article class="project-card" data-category={item.category}>
            <div class="card-top">
              <h2 class="card-name">{item.name}</h2>
              {item.version && (
                <span class="card-version">v{item.version}</span>
              )}
            </div>
            <p class="card-desc">{item.description}</p>
            {(item.demo || item.repo) && (
              <div class="card-links">
                {item.demo && (
                  <a
                    class="card-link"
                    href={item.demo}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Live demo ↗
                  </a>
                )}
                {item.repo && (
                  <a
                    class="card-link"
                    href={item.repo}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Source ↗
                  </a>
                )}
              </div>
            )}
            <div class="card-footer">
              <div class="card-stack">
                {item.stack.map((tag) => (
                  <span class="stack-tag">{tag}</span>
                ))}
              </div>
              <span class="card-category">{item.category}</span>
            </div>
          </article>
        ))}
        <p class="empty-state" id="empty-state">
          No projects in this category.
        </p>
      </div>
    </section>
    <Contact />
  </main>
  <script>
    const bar = document.querySelector("#filter-bar");
    const cards = [...document.querySelectorAll<HTMLElement>(".project-card")];
    bar?.addEventListener("click", (event) => {
      const target = (event.target as Element).closest<HTMLButtonElement>(
        ".filter-btn",
      );
      if (!target) return;
      bar.querySelectorAll(".filter-btn").forEach((button) => {
        const active = button === target;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      let visible = 0;
      cards.forEach((card) => {
        const show =
          target.dataset.filter === "All" ||
          card.dataset.category === target.dataset.filter;
        card.hidden = !show;
        if (show) visible++;
      });
      const count = document.querySelector("#project-count");
      if (count)
        count.textContent = `${visible} project${visible === 1 ? "" : "s"}`;
      document
        .querySelector("#empty-state")
        ?.classList.toggle("is-visible", visible === 0);
    });
  </script>
</Layout>
